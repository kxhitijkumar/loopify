{
  "expo": {
    "name": "MusicPlayer",
    "slug": "music-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.yourname.musicplayer"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ca5e8817-84bc-4744-a2f6-dc8840708801"
      }
    }
  }
}
